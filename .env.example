# Porta do servidor (padrão: 3000)
PORT=3000

# Hash bcrypt da senha do administrador
# Gerar com: node -e "const b=require('bcryptjs');b.hash('SUA_SENHA',12).then(console.log)"
ADMIN_PASSWORD_HASH=

# Segredos JWT — gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=

# URL pública do site (usada em links canônicos e redirecionamentos)
SITE_URL=https://www.reginaldoimoveis.com.br

# Origens permitidas no CORS (separar múltiplas por vírgula)
CORS_ORIGIN=https://www.reginaldoimoveis.com.br

# Ambiente de execução
NODE_ENV=production
