rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Imagens de imóveis ────────────────────────────────────
    // Qualquer visitante pode ler (as imagens ficam públicas no site);
    // apenas admin autenticado pode fazer upload
    match /imoveis/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // max 10 MB
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
